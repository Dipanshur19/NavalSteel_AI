{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://navalsteel.ai/schema/materials.schema.json",
  "title": "NavalSteel AI Material Record",
  "type": "object",
  "required": ["schema_version", "record_id", "paper", "steel"],
  "properties": {
    "schema_version": { "type": "string" },
    "record_id": { "type": "string" },
    "paper": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string" },
        "doi": { "type": ["string", "null"] },
        "author": { "type": ["string", "null"] },
        "year": { "type": ["integer", "null"] },
        "institution": { "type": ["string", "null"] },
        "section": { "type": ["string", "null"] }
      }
    },
    "steel": {
      "type": "object",
      "required": ["name", "composition"],
      "properties": {
        "name": { "type": "string" },
        "base_element": { "type": "string", "default": "Fe" },
        "alloy_family": { "type": ["string", "null"] },
        "composition": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["element", "status"],
            "properties": {
              "element": { "type": "string" },
              "value": { "type": ["number", "null"] },
              "unit": { "type": "string", "default": "wt%" },
              "status": { "$ref": "#/definitions/evidenceStatus" },
              "is_balance": { "type": "boolean", "default": false },
              "evidence": { "$ref": "#/definitions/evidence" }
            }
          }
        }
      }
    },
    "processing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step"],
        "properties": {
          "step": { "type": "string" },
          "temperature_C": { "type": ["number", "null"] },
          "time": { "type": ["string", "null"] },
          "cooling": { "type": ["string", "null"] },
          "notes": { "type": ["string", "null"] },
          "evidence": { "$ref": "#/definitions/evidence" }
        }
      }
    },
    "microstructure": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["feature", "status"],
        "properties": {
          "feature": { "type": "string" },
          "phase": { "type": ["string", "null"] },
          "size_nm": { "type": ["number", "null"] },
          "formers": { "type": "array", "items": { "type": "string" } },
          "status": { "$ref": "#/definitions/evidenceStatus" },
          "evidence": { "$ref": "#/definitions/evidence" }
        }
      }
    },
    "properties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["property", "status"],
        "properties": {
          "property": { "type": "string" },
          "value": { "type": ["number", "null"] },
          "unit": { "type": ["string", "null"] },
          "temperature_C": { "type": ["number", "null"] },
          "status": { "$ref": "#/definitions/evidenceStatus" },
          "is_proxy_for": { "type": ["string", "null"] },
          "evidence": { "$ref": "#/definitions/evidence" }
        }
      }
    },
    "weldability_indicators": {
      "type": ["object", "null"],
      "properties": {
        "carbon_wt_pct": { "type": ["number", "null"] },
        "rule_of_thumb_limit_wt_pct": { "type": ["number", "null"] },
        "carbon_equivalent": { "type": ["number", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "mechanisms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "relation", "label"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "relation": { "type": "string" },
          "label": { "$ref": "#/definitions/relationLabel" },
          "supporting_paper_ids": { "type": "array", "items": { "type": "string" } },
          "evidence": { "$ref": "#/definitions/evidence" }
        }
      }
    },
    "design_rationale": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "definitions": {
    "evidenceStatus": {
      "type": "string",
      "enum": ["MEASURED", "PREDICTED", "TARGET", "INFERRED", "UNKNOWN"]
    },
    "relationLabel": {
      "type": "string",
      "enum": ["EXPLICIT", "INFERRED", "UNKNOWN", "CONTRADICTED"]
    },
    "evidence": {
      "type": ["object", "null"],
      "properties": {
        "claim": { "type": "string" },
        "source_page": { "type": ["integer", "null"] },
        "quote_or_span": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
