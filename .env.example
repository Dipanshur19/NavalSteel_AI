# Copy this file to .env and fill in your own values.
# .env is git-ignored - never commit real API keys.

# Required for live extraction/RAG (Extraction Agent + LLM-synthesized RAG answers).
# Without an API key, the pipeline runs fully in offline/extractive mode.

# LLM Provider selection: "auto" (default: uses Gemini if key set, else Anthropic), "gemini", or "anthropic"
LLM_PROVIDER=auto

# Google Gemini API key (free tier from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_EXTRACTION_MODEL=gemini-3.6-flash
GEMINI_RAG_MODEL=gemini-3.6-flash

# Anthropic Claude API key
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-sonnet-4-6
RAG_MODEL=claude-sonnet-4-6

# Embedding backend: "tfidf" (default, fully offline) or "sbert" (better
# semantic recall, downloads a model from Hugging Face on first use).
EMBEDDING_BACKEND=tfidf
SBERT_MODEL_NAME=all-MiniLM-L6-v2

# Chunking
CHUNK_SIZE_CHARS=1800
CHUNK_OVERLAP_CHARS=200

# Retrieval
TOP_K=5
