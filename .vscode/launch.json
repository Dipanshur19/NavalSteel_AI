{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Ingest PDF",
      "type": "debugpy",
      "request": "launch",
      "module": "src.ingest_pdf",
      "args": ["--pdf", "data/raw/blastalloy160_saha_2004.pdf"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "2. Chunk document",
      "type": "debugpy",
      "request": "launch",
      "module": "src.chunk",
      "args": ["--doc", "data/processed/blastalloy160_saha_2004.json"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "3. Build embedding index",
      "type": "debugpy",
      "request": "launch",
      "module": "src.embed",
      "args": ["--chunks", "data/processed/blastalloy160_saha_2004.chunks.json", "--backend", "tfidf"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "4. RAG query (dry-run, no API key needed)",
      "type": "debugpy",
      "request": "launch",
      "module": "src.rag",
      "args": [
        "What is the Concept-B composition of BlastAlloy160?",
        "--index", "data/index/blastalloy160_saha_2004.index.pkl",
        "--dry-run"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "5. Extraction agent (dry-run)",
      "type": "debugpy",
      "request": "launch",
      "module": "src.extract",
      "args": [
        "--text", "data/processed/blastalloy160_saha_2004.json",
        "--record-id", "blastalloy160_test",
        "--dry-run"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "6. Run Phase-1 acceptance checks",
      "type": "debugpy",
      "request": "launch",
      "module": "src.validate",
      "args": ["--index", "data/index/blastalloy160_saha_2004.index.pkl", "--dry-run"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "7. Run Streamlit dashboard",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "streamlit_app.py"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run all tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-v"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
