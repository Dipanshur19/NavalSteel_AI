# Secrets
.env

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/

# Pipeline outputs derived from source PDFs you place in data/raw/
# (kept out of git because they can be large and, for copyrighted source
# papers, may contain substantial extracted text of the original work).
data/raw/*.pdf
data/processed/*.json
data/index/*.pkl

# Keep the hand-built gold-standard records and baseline index for cloud deployment.
!data/extracted/*.json
!data/processed/blastalloy160_saha_2004.chunks.json
!data/processed/blastalloy160_saha_2004.json
!data/index/blastalloy160_saha_2004.index.pkl
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/index/.gitkeep

# OS / editor
.DS_Store
.vscode/*.log
